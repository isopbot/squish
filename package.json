{
  "name": "squish",
  "productName": "Squish",
  "version": "1.0.0",
  "description": "Squish · 本地批量图片压缩工具（多格式无损压缩）",
  "main": "src/main/index.js",
  "author": "Squish contributors",
  "license": "MIT",
  "private": false,
  "keywords": [
    "image-compression",
    "tinypng",
    "electron",
    "sharp",
    "lossless",
    "webp",
    "avif"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:engine": "node scripts/test-engine.js",
    "icon": "node scripts/make-icon.js",
    "native:status": "node scripts/native-deps.js status",
    "dist:mac:arm64": "node scripts/native-deps.js ensure darwin arm64 && node scripts/native-deps.js prune darwin arm64 && electron-builder --mac --arm64",
    "dist:mac:x64": "node scripts/native-deps.js ensure darwin x64 && node scripts/native-deps.js prune darwin x64 && electron-builder --mac --x64",
    "dist:mac": "npm run dist:mac:arm64 && npm run dist:mac:x64 && npm run restore:dev",
    "dist:win": "node scripts/native-deps.js ensure win32 x64 && node scripts/native-deps.js prune win32 x64 && electron-builder --win --x64",
    "dist": "npm run dist:mac && npm run dist:win && npm run restore:dev",
    "restore:dev": "node scripts/native-deps.js ensure darwin arm64 && node scripts/native-deps.js prune darwin arm64"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.squish.image",
    "productName": "Squish",
    "copyright": "Copyright © 2026 Squish",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Squish"
    },
    "portable": {
      "artifactName": "Squish-${version}-portable.exe"
    }
  }
}
